      propertyPath: m_text
      value: '<line-indent=0%>Score is added each time you collect a Coin

        Combo</line-indent>

        <line-indent=2%>Landing
        on Coin tiles consecutively increases your Combo, boosting your score multiplier

        Landing
        on any other tile resets your Combo</line-indent>

        <line-indent=0%>Round
        Clear Bonus</line-indent>

        <line-indent=2%>Collecting more Coins
        than the goal earns bonus score</line-indent>

        <line-indent=0%>Score
        multipliers increase as rounds progress</line-indent>'
      objectReference: {fileID: 0}
