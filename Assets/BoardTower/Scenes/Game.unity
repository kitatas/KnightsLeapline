      value: Text (TMP)
      objectReference: {fileID: 0}
    - target: {fileID: 8823592400571631213, guid: c975824622da54ddd969c1c7e485f20c, type: 3}
      propertyPath: m_text
      value: "<line-indent=0%>Round Flow</line-indent>\n<line-indent=2%>1. Each round
        has a Move limit and a Coin goal\n2. Tiles your Knight can move to will be
        highlighted \u2014 tap to move\n3. Collect enough Coins before your Moves
        run out to Clear the Round\n4. Fail to reach the Coin goal and it's Game
        Over\n5. Clear all 7 Rounds to achieve Game Clear</line-indent>\n<line-indent=0%>How
        the Knight Moves</line-indent>\n<line-indent=2%>The Knight moves in an \"L-shape,\"
        just like in chess.\nIt cannot move to Spike tiles by default.</line-indent>"
      objectReference: {fileID: 0}
    - target: {fileID: 8823592400571631213, guid: c975824622da54ddd969c1c7e485f20c, type: 3}
