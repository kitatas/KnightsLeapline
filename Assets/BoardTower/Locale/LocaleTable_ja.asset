  - m_Id: 30384012257124356
    m_Localized: "\u30B3\u30A4\u30F3\u7372\u5F97\u6642\u3001{0}%\u306E\u78BA\u7387\u3067\u8FFD\u52A0\u306E\u30B3\u30A4\u30F3\u3092{1}\u679A\u7372\u5F97\u3059\u308B"
    m_Metadata:
      m_Items: []
  - m_Id: 30384012257124357
    m_Localized: "\u30CF\u30FC\u30C8\u7372\u5F97\u6642\u3001{0}%\u306E\u78BA\u7387\u3067\u8FFD\u52A0\u306E\u30CF\u30FC\u30C8\u3092{1}\u3064\u7372\u5F97\u3059\u308B"
    m_Metadata:
      m_Items: []
  - m_Id: 30384012257124358
    m_Localized: "\u30B3\u30A4\u30F3\u4EE5\u5916\u306E\u30DE\u30B9\u306B\u7740\u5730\u3057\u3066\u3082\u3001{0}%\u306E\u78BA\u7387\u3067\u30B3\u30F3\u30DC\u304C\u7D99\u7D9A\u3059\u308B"
    m_Metadata:
      m_Items: []
  - m_Id: 30384012257124359
    m_Localized: "\u624B\u6570\u3068\u30E9\u30A6\u30F3\u30C9\u76EE\u6A19\u30B3\u30A4\u30F3\u6570\u304C\u534A\u6E1B\u3059\u308B\u3002\u30B3\u30A4\u30F3\u7372\u5F97\u30B9\u30B3\u30A2\u304C{1}%\u4E0A\u6607\u3059\u308B"
    m_Metadata:
      m_Items: []
  - m_Id: 30384012257124360
    m_Localized: "\u76EE\u6A19\u30B3\u30A4\u30F3\u6570\u3092\u8D85\u3048\u3066\u30E9\u30A6\u30F3\u30C9\u3092\u30AF\u30EA\u30A2\u3059\u308B\u3068\u3001\u7372\u5F97\u30B9\u30B3\u30A2\u304C{1}%\u4E0A\u6607\u3059\u308B"
